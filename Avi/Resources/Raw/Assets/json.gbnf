boolean ::= ("true" | "false") space
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
item ::= item-0 | item-1 | item-2 | item-3 | item-4
item-0 ::= "{" space item-0-type-kv "," space item-0-content-kv "}" space
item-0-content-kv ::= "\"content\"" space ":" space string
item-0-type ::= "\"cmd\"" space
item-0-type-kv ::= "\"type\"" space ":" space item-0-type
item-1 ::= "{" space item-1-type-kv "," space item-1-variant-kv "," space item-1-content-kv "}" space
item-1-content-kv ::= "\"content\"" space ":" space string
item-1-type ::= "\"message\"" space
item-1-type-kv ::= "\"type\"" space ":" space item-1-type
item-1-variant ::= ("\"short\"" | "\"long\"" | "\"voice\"") space
item-1-variant-kv ::= "\"variant\"" space ":" space item-1-variant
item-2 ::= "{" space item-2-type-kv "," space item-2-content-kv "}" space
item-2-content ::= ("\"Neutral\"" | "\"Confused\"" | "\"Happy\"" | "\"Scared\"" | "\"VeryScared\"" | "\"Annoyed\"" | "\"Afraid\"" | "\"Sad\"" | "\"Angry\"" | "\"ForcedSmile\"") space
item-2-content-kv ::= "\"content\"" space ":" space item-2-content
item-2-type ::= "\"face\"" space
item-2-type-kv ::= "\"type\"" space ":" space item-2-type
item-3 ::= "{" space item-3-type-kv "," space item-3-content-kv "}" space
item-3-content ::= ("\"eyeroll\"" | "\"blink\"") space
item-3-content-kv ::= "\"content\"" space ":" space item-3-content
item-3-type ::= "\"action\"" space
item-3-type-kv ::= "\"type\"" space ":" space item-3-type
item-4 ::= "{" space item-4-type-kv "," space item-4-content-kv "}" space
item-4-content ::= "{" space  (item-4-content-color-kv item-4-content-color-rest | item-4-content-shutdown-kv item-4-content-shutdown-rest | item-4-content-restart-kv )? "}" space
item-4-content-color ::= "\"" ("#" (item-4-content-color-1{6,6} | item-4-content-color-1{3,3})) "\"" space
item-4-content-color-1 ::= [A-Fa-f0-9]
item-4-content-color-kv ::= "\"color\"" space ":" space item-4-content-color
item-4-content-color-rest ::= ( "," space item-4-content-shutdown-kv )? item-4-content-shutdown-rest
item-4-content-kv ::= "\"content\"" space ":" space item-4-content
item-4-content-restart-kv ::= "\"restart\"" space ":" space boolean
item-4-content-shutdown-kv ::= "\"shutdown\"" space ":" space boolean
item-4-content-shutdown-rest ::= ( "," space item-4-content-restart-kv )?
item-4-type ::= "\"settings\"" space
item-4-type-kv ::= "\"type\"" space ":" space item-4-type
root ::= "[" space (item ("," space item)*)? "]" space
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\"" space
