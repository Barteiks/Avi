<?xml version="1.0" encoding="utf-8" ?>
<Window xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Avi.MainWindow"
             xmlns:local="using:Avi"
             Title="NewWindow1">
    <Window.TitleBar>
        <TitleBar
            Title="HelperAI"
            Subtitle="Demo"
            BackgroundColor="#FF1E1E1E"
            ForegroundColor="#feffed"
            HeightRequest="48">
            <!-- Opcjonalna zawartość w TitleBar -->
            <TitleBar.TrailingContent>
                <ImageButton HeightRequest="36"
                             Clicked="SettingsButton_Clicked"
                     WidthRequest="36"
                     BorderWidth="0"
                     Background="Transparent">
                    <ImageButton.Source>
                        <FontImageSource Size="16"
                                 Glyph="&#xE713;"
                                 FontFamily="SegoeFluentIcons"/>
                    </ImageButton.Source>
                </ImageButton>
            </TitleBar.TrailingContent>
        </TitleBar>
    </Window.TitleBar>
</Window>