<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:local="clr-namespace:Avi.face"
             x:Class="Avi.MainPage"
             BackgroundColor="#FF1E1E1E"
             Title="HelperAI">
    <AbsoluteLayout>

        <!-- MAIN UI -->
        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All">
            <Grid RowDefinitions="Auto,*,Auto">

        <Grid Row="1"
      x:Name="HomePage"
      HorizontalOptions="Fill"
      VerticalOptions="Fill">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#d1bb45" Offset="-2"/>
                    <GradientStop Color="#FF1E1E1E" Offset="0.7"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid x:Name="face" WidthRequest="800" HeightRequest="450"
                  HorizontalOptions="Center" VerticalOptions="Center">
                <local:Face x:Name="FaceView" HorizontalOptions="Fill" VerticalOptions="Fill" />
                <!-- face -->

            </Grid>

            <!-- Bottom: Output and right-side label -->
            <Grid x:Name="DEBUG2" Row="2" Margin="0,0,12,12" VerticalOptions="End" IsVisible="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                        <Editor x:Name="OutputBox"
                        Grid.Column="0"
                        HeightRequest="108"
                        TextColor="Blue"
                        BackgroundColor="White"
                        FontSize="20"/>
                        <Button x:Name="SettingsButton"
                        Clicked="OpenSettings"
                                WidthRequest="5"
                                HeightRequest="5"></Button>
                        <Editor x:Name="label"
                        Grid.Column="1"
                        WidthRequest="147"
                        HeightRequest="220"
                        TextColor="Blue"
                        Margin="12,0,0,0"
                        BackgroundColor="White"/>
            </Grid>
        </Grid>
            </Grid>
            <!-- hidden button used only for KeyboardAccelerator (F1) to toggle debug visibility on desktop -->
        <Button x:Name="F1Toggle" IsVisible="False" Clicked="OnF1ToggleClicked">
        </Button>
        <BoxView
        x:Name="Overlay"
        BackgroundColor="#FF1E1E1E"
        Opacity="0"
        IsVisible="False"/>
        <!-- PANEL USTAWIEŃ -->
        <Grid x:Name="SettingsContainer"
      BackgroundColor="#FF1E1E1E"
      HorizontalOptions="Fill"
      VerticalOptions="Fill"
      IsVisible="False"
      Opacity="0"
      TranslationY="1000"></Grid>
    </Grid>
    </AbsoluteLayout>
</ContentPage>
